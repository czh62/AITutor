###########################
### Server Configuration
###########################
PORT=9621
WEBUI_TITLE='My First LightRAG KB'
WEBUI_DESCRIPTION='Simple and Fast Graph Based RAG System'
OLLAMA_EMULATING_MODEL_TAG=latest

########################################
### Document processing configuration
########################################
SUMMARY_LANGUAGE=English
ENTITY_EXTRACTION_USE_JSON=true
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
VLM_PROCESS_ENABLE=false

###########################################################################
### LLM Configuration
###########################################################################
LLM_BINDING=openai
LLM_BINDING_HOST=https://your-llm-api-host/v1
LLM_BINDING_API_KEY=your-llm-api-key
LLM_MODEL=deepseek-v4-flash
KEYWORD_LLM_MODEL=deepseek-v4-flash
QUERY_LLM_MODEL=deepseek-v4-flash
### Max concurrency requests of LLM
### MAX_ASYNC is still accepted as a deprecated alias
MAX_ASYNC_LLM=4

#######################################################################################
### Embedding Configuration (do not change after the first file is processed)
#######################################################################################
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://your-embedding-api-host/v1
EMBEDDING_BINDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=true

###########################################################################
### Reranking Configuration
###########################################################################
RERANK_BINDING=cohere
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=https://your-rerank-api-host/v1/rerank
RERANK_BINDING_API_KEY=your-rerank-api-key

############################
### Data storage selection
############################
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

############################
### AITutor AgentLoop Search
############################
SEARCH_ENABLED=true
SEARCH_MAX_RESULTS=5
